PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
SHUTDOWN_TIMEOUT=5s
DEMO_GENERATOR=true

# Host-side URL. Compose sets its own URL on the api and migrate services.
DATABASE_URL=postgres://contract_ops:contract_ops@localhost:5432/contract_ops?sslmode=disable

# Local workspace key, same kind of secret as the database password above.
# The event feed does not require it. Later mutating routes do.
BOOTSTRAP_API_KEY=co_local_dev_key_not_for_production

# 32-byte local master key, base64. It wraps credential data keys. Not for production.
MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
POSTGRES_USER=contract_ops
POSTGRES_PASSWORD=contract_ops
POSTGRES_DB=contract_ops
