{
  "name": "contract-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "postinstall": "npm ci --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix web",
    "build:vite": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build:vite",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "jsdom": "24.1.3",
    "playwright": "^1.49.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "5.4.21",
    "vitest": "1.6.1"
  }
}
